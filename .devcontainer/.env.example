# Copy to .devcontainer/.env (gitignored) and adjust per host.
# HF_TOKEN=hf_xxx                      # ThaiOCRBench / model downloads if gated
# DATA_DIR=/raid/ocr-bench/data       # host data dir -> /data; default ./data in the repo
# MODELS_DIR=/raid/hf-cache            # host HF cache (model weights); default ~/.cache/huggingface
# VLLM_IMAGE=vllm/vllm-openai:v0.11.0  # pin the same tag on every GPU host (spec §8)
# VLLM_DTYPE=bfloat16
# TELEOCR_GPU=0
# DOTSOCR_GPU=1
# TYPHOON_GPU=2
# TELEOCR_PORT=8001
# DOTSOCR_PORT=8002
# TYPHOON_PORT=8003
# VLLM_IMAGE_NEW=vllm/vllm-openai:v0.22.1  # OvisOCR2 (needs >= 0.18) and PaddleOCR-VL-1.6 (>= 0.11.1)
# OVISOCR2_GPU=0
# PADDLEOCR_VL_GPU=0
# OVISOCR2_PORT=8004
# PADDLEOCR_VL_PORT=8005
# PADDLE_PIPELINE_PORT=8006
# docparse (profile: docparse). On one H100 with the Paddle pipeline, per design D3:
# PADDLEOCR_VL_GPU_MEM=0.25            # default 0.9 when Paddle runs alone
# QWEN3VL_GPU=0
# QWEN3_GPU=0
# QWEN3VL_GPU_MEM=0.30
# QWEN3_GPU_MEM=0.25
# QWEN3VL_PORT=8014
# QWEN3_PORT=8015
